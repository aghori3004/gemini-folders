{
  "name": "gemini-folders",
  "displayName": "Gemini Folders",
  "version": "1.0.0",
  "description": "Organize your Gemini chats into folders. Create, manage, and search folders to keep your AI conversations structured and accessible.",
  "author": "Divyansh Gangwar <divyanshgangwar3004@gmail.com>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "firebase": "^10.13.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.4.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "storage",
      "identity"
    ],
    "host_permissions": [
      "https://gemini.google.com/*",
      "https://*.firebaseio.com/*",
      "https://*.googleapis.com/*",
      "https://*.firebaseapp.com/*"
    ],
    "oauth2": {
      "client_id": "232018677282-c91n9qct1k83dhquliuakh7kkcutnsr9.apps.googleusercontent.com",
      "scopes": [
        "https://www.googleapis.com/auth/userinfo.email",
        "https://www.googleapis.com/auth/userinfo.profile"
      ]
    },
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data: https://lh3.googleusercontent.com https://*.googleusercontent.com;"
    },
    "web_accessible_resources": [
      {
        "resources": [
          "*.js",
          "*.css"
        ],
        "matches": [
          "https://gemini.google.com/*"
        ]
      }
    ]
  }
}